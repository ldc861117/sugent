# Sugent GCE 常驻中枢环境变量模板
# 使用前请复制为 .env 并赋予仅属主读写权限（600），切勿将真实凭证提交入库

# 镜像地址（默认拉取最新构建产物，可固定为 sha-<commit> 标签以实现可回滚发布）
SUGENT_IMAGE=ghcr.io/ldc861117/sugent:latest

# 节点身份与微信单持有者锁（gce-hub 独占微信 iLink 长轮询，local-mac 自动只读防抢消息）
SUGENT_NODE_ID=gce-hub
SUGENT_STEWARD_HUB_NODE=gce-hub
SUGENT_WEIXIN_OWNER_NODE=gce-hub

# Andy-web /ops 舰队中枢桥接配置（填入完整 Cloud Run 服务根地址与节点令牌；OPS_NODE_ID 可指定 Andy-web 已注册节点名如 gce-airtoken）
OPS_BASE_URL=
OPS_NODE_ID=gce-airtoken
OPS_NODE_TOKEN=

# 原生边缘触手中枢鉴权令牌（供 Mac 本机 local-mac 与云端 gce-remote 触手上报项目态势与拉取 Antigravity 派单）
SUGENT_EDGE_TOKEN=

# Web UI 访问令牌（可选，留空首次启动时自动生成于 /data/ui-token）
AMB_UI_TOKEN=

# 可选：外置 OpenAI 兼容网关（若不启用内置 magpie 托管网关可按需配置）
# AMB_MAGPIE_BASE_URL=
# AMB_MAGPIE_API_KEY=
