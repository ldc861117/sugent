# Sugent / AnyModelBot 环境变量（全部可选；环境变量优先于 <数据目录>/config.json）
# 复制为 .env 后由你的进程管理器 / `docker run --env-file` 加载（程序本身不自动读取 .env）

# ============================================================================
# 🚀 Sugent 专属增强配置（网关解耦 / 订阅复用 / 角色分层模型路由）
# ============================================================================
# 网关工作模式：byok | subscription | external | modelflare
# SUGENT_GATEWAY_MODE=external
#
# 外部或本地独立网关地址（如本地运行的原版 yetone/magpie、LiteLLM、OneAPI、Ollama 等）
# 设置后自动跳过 Modelflare 登录，直接将模型请求路由至该端点：
# SUGENT_GATEWAY_URL=http://127.0.0.1:3425/v1
# SUGENT_GATEWAY_KEY=magpie
#
# 是否解锁原版 magpie 的本地订阅账户发现（1 = 允许复用本机 Claude Code / ChatGPT / Copilot 订阅）
# SUGENT_UNLOCK_SUBSCRIPTIONS=1
#
# 是否开启本地隐私脱敏（1 = 请求发出前将密钥/邮箱替换为 {{API_KEY_...}} 占位符）
# SUGENT_PRIVACY_MASKING=1
#
# 四角色分层模型路由（小模型守门降噪、大模型攻坚执行、视觉模型操控桌面）：
# SUGENT_MODEL_ASSESSOR=deepseek/deepseek-chat
# SUGENT_MODEL_EXECUTOR=anthropic/claude-sonnet-4-5
# SUGENT_MODEL_COMPUTER_USE=anthropic/claude-sonnet-4-5
# SUGENT_MODEL_STEWARD=deepseek/deepseek-chat

# ============================================================================
# 宿主基础配置（兼容上游 AnyModelBot）
# ============================================================================
# 数据目录（SQLite、magpie 隔离配置、微信登录态）。默认 ./data；桌面版默认 <userData>/data
# AMB_DATA_DIR=./data

# 管理界面。非回环地址（如 0.0.0.0）会强制令牌访问，令牌见 <数据目录>/ui-token
# AMB_UI_HOST=127.0.0.1
# AMB_UI_PORT=3600
# AMB_UI_TOKEN=

# 内置 magpie 可执行文件（默认自动查找 build/bin 或桌面版 resources/magpie）
# AMB_MAGPIE_BIN=

# 改用外部 OpenAI 兼容端点（设置后不启动内置网关，界面视为已连接、不显示 Modelflare 连接管理）
# AMB_MAGPIE_BASE_URL=http://127.0.0.1:8080/v1
# AMB_MAGPIE_API_KEY=

# 仅开发/测试：把 Modelflare 基址指向本地 mock（界面无法设置；正式使用只有 modelflare.dev 与 origin.modelflare.dev 两条线路）
# AMB_MODELFLARE_BASE_URL=http://127.0.0.1:8080/v1
# 仅开发/测试：把账户登录（OIDC 发现文档、授权、令牌）与账户接口指向本地 mock；正式使用固定为 https://modelflare.dev
# AMB_MODELFLARE_ISSUER=http://127.0.0.1:8080

# 对话
# AMB_DEFAULT_MODEL=openai/gpt-5.6-sol
# AMB_CONTEXT_MESSAGES=40
# AMB_CONTEXT_CHARS=24000

# 飞书（仅首次创建默认机器人时读取；之后在界面信息面板「渠道」里修改）
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=
# AMB_FEISHU_THROTTLE_MS=400

# 微信 iLink 接口地址（一般不用改）
# AMB_WEIXIN_API_BASE=https://ilinkai.weixin.qq.com

# Windows：代理执行命令用的 PowerShell。没有能用的 PowerShell 7 时应用会在后台自动装一份（%LOCALAPPDATA%\AnyModelBot\pwsh）
# AMB_PWSH_AUTO_INSTALL=0          # 不自动安装（设置 → 故障排查里仍可手动安装）
# AMB_PWSH_MIRROR=https://…/       # 下载镜像前缀（后面接 PowerShell-<版本>-win-<架构>.zip；照样核对 SHA256 和签名）
# AMB_PWSH_HOME=                   # 安装位置
# AMB_PWSH_IGNORE_SYSTEM=1         # 仅测试：不用系统里的 PowerShell（CI 用它验证内置副本）

# 语言：界面设置里选"跟随系统"时用的语言（zh-CN | en）。不设时看 LC_ALL / LANG，没有或是 C / POSIX 时用简体中文。
# 托盘菜单、服务端报错、机器人发到微信 / 飞书的系统消息都跟着应用语言；界面里可以随时切换
# AMB_LANG=zh-CN

# 日志级别 debug|info|warn|error
# AMB_LOG_LEVEL=info
